generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id              String   @id @default(cuid())
  mint            String   @unique
  name            String
  symbol          String
  description     String?
  imageUrl        String?
  websiteUrl      String?
  twitterUrl      String?
  telegramUrl     String?
  creator         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Curve state (cached from on-chain)
  virtualSolReserves    BigInt @default(30000000000)
  virtualTokenReserves  BigInt @default(1073000191000000)
  realSolReserves       BigInt @default(0)
  realTokenReserves     BigInt @default(700000000000000)
  totalSupply           BigInt @default(1000000000000000)

  // Stats
  marketCapSol    Float    @default(0)
  priceUsd        Float    @default(0)
  volume24h       Float    @default(0)
  trades          Int      @default(0)
  holders         Int      @default(0)
  isGraduated     Boolean  @default(false)
  graduatedAt     DateTime?
  raydiumPoolId   String?
  // True only once the pool's LP tokens are confirmed burned to the incinerator.
  // A graduated token with raydiumPoolId set but raydiumLpBurned=false means the
  // liquidity is NOT locked yet and needs operator reconciliation.
  raydiumLpBurned Boolean  @default(false)

  // Relations
  tradeHistory    Trade[]
  comments        Comment[]

  @@index([creator])
  @@index([isGraduated])
  @@index([marketCapSol])
  @@index([createdAt])
  @@index([volume24h])
}

model Trade {
  id          String    @id @default(cuid())
  signature   String    @unique
  mint        String
  trader      String
  type        TradeType
  solAmount   BigInt
  tokenAmount BigInt
  price       Float
  fee         BigInt
  timestamp   DateTime
  createdAt   DateTime  @default(now())

  token       Token     @relation(fields: [mint], references: [mint])

  @@index([mint])
  @@index([trader])
  @@index([timestamp])
}

enum TradeType {
  BUY
  SELL
}

model Comment {
  id        String   @id @default(cuid())
  mint      String
  wallet    String
  text      String   @db.VarChar(280)
  createdAt DateTime @default(now())

  token     Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)

  @@index([mint])
  @@index([createdAt])
}

// Per-mint holder balances — maintained by the indexer on every buy/sell.
// Replaces the expensive "SELECT … GROUP BY trader" fallback and the
// multi-round-trip RPC path in GET /tokens/:mint/holders.
model Holder {
  id        Int      @id @default(autoincrement())
  mint      String
  wallet    String
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([mint, wallet])
  @@index([mint, balance])
}

// Per-mint per-minute volume buckets — maintained by the indexer on every trade.
// Replaces the expensive per-trade Trade.aggregate(last 24h) scan.
// 24h of 1-minute buckets = ≤1440 rows per mint (fast, indexed).
model TradeVolumeBucket {
  id             Int      @id @default(autoincrement())
  mint           String
  bucketStart    DateTime
  volumeLamports BigInt   @default(0)
  trades         Int      @default(0)
  updatedAt      DateTime @updatedAt

  @@unique([mint, bucketStart])
  @@index([mint, bucketStart])
}

// Social follow graph — wallet-to-wallet, no auth required (wallet IS identity)
model Follow {
  id          String   @id @default(cuid())
  follower    String   // wallet that is following
  following   String   // wallet being followed (creator)
  createdAt   DateTime @default(now())

  @@unique([follower, following])
  @@index([follower])
  @@index([following])
}

model CreatorProfile {
  wallet      String   @id
  displayName String?
  bio         String?
  avatarUrl   String?
  twitterUrl  String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       CreatorPost[]
}

model CreatorPost {
  id        String   @id @default(cuid())
  wallet    String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  creator   CreatorProfile @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
}

model ReferralAccount {
  wallet          String   @id
  referralCode    String   @unique
  // Money stored as fixed-point Decimal (SOL, 9 dp) — never Float — so balances
  // and threshold comparisons are exact.
  pendingBalance  Decimal  @default(0) @db.Decimal(20, 9)
  totalEarned     Decimal  @default(0) @db.Decimal(20, 9)
  totalReferrals  Int      @default(0)
  lastWithdrawnAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReferralLink {
  id              String   @id @default(cuid())
  referredWallet  String   @unique
  referrerWallet  String
  cashbackBalance Decimal  @default(0) @db.Decimal(20, 9)
  cashbackEarned  Decimal  @default(0) @db.Decimal(20, 9)
  createdAt       DateTime @default(now())
}

// Append-only ledger of every SOL payout (referral withdrawal / cashback claim).
// Gives payouts an auditable trail and an idempotency key so a claim can never
// be paid twice: the row is created (debiting the balance in the same tx) BEFORE
// the on-chain transfer, then marked COMPLETED or FAILED.
model Payout {
  id         String       @id @default(cuid())
  wallet     String
  kind       PayoutKind
  amountSol  Decimal      @db.Decimal(20, 9)
  status     PayoutStatus @default(PENDING)
  txSig      String?
  error      String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  @@index([wallet])
  @@index([status])
}

enum PayoutKind {
  REFERRAL
  CASHBACK
}

enum PayoutStatus {
  PENDING
  COMPLETED
  FAILED
}


model TelegramUser {
  id            Int      @id @default(autoincrement())
  telegramId    String   @unique
  username      String?
  firstName     String?
  encryptedKey  String
  walletAddress String
  slippageBps   Int      @default(300)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model BotAlert {
  id           Int      @id @default(autoincrement())
  telegramId   String
  chatId       String
  mint         String
  symbol       String   @default("TOKEN")
  alertType    String   // price_above | price_below | stop_loss | take_profit
  triggerPrice Float
  tokenAmount  String?
  triggered    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([isActive])
  @@index([telegramId])
  @@index([mint, isActive])
}

