generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Token {
  id              String   @id @default(cuid())
  mint            String   @unique
  name            String
  symbol          String
  description     String?
  imageUrl        String?
  metadataUri     String?
  websiteUrl      String?
  twitterUrl      String?
  telegramUrl     String?
  creator         String
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  // Curve state (cached from on-chain)
  virtualSolReserves    BigInt @default(30000000000)
  virtualTokenReserves  BigInt @default(1073000191000000)
  realSolReserves       BigInt @default(0)
  realTokenReserves     BigInt @default(700000000000000)
  totalSupply           BigInt @default(1000000000000000)

  // Stats
  marketCapSol    Float    @default(0)
  priceUsd        Float    @default(0)
  volume24h       Float    @default(0)
  trades          Int      @default(0)
  holders         Int      @default(0)
  isGraduated     Boolean  @default(false)
  graduatedAt     DateTime?
  raydiumPoolId   String?

  // Relations
  tradeHistory    Trade[]
  comments        Comment[]

  @@index([creator])
  @@index([isGraduated])
  @@index([marketCapSol])
  @@index([createdAt])
  @@index([volume24h])
}

model Trade {
  id          String    @id @default(cuid())
  signature   String    @unique
  mint        String
  trader      String
  type        TradeType
  solAmount   BigInt
  tokenAmount BigInt
  price       Float
  fee         BigInt
  timestamp   DateTime
  createdAt   DateTime  @default(now())

  token       Token     @relation(fields: [mint], references: [mint])

  @@index([mint])
  @@index([trader])
  @@index([timestamp])
}

enum TradeType {
  BUY
  SELL
}

model Comment {
  id        String   @id @default(cuid())
  mint      String
  wallet    String
  text      String   @db.VarChar(280)
  createdAt DateTime @default(now())

  token     Token    @relation(fields: [mint], references: [mint], onDelete: Cascade)

  @@index([mint])
  @@index([createdAt])
}

model Holder {
  id        Int      @id @default(autoincrement())
  mint      String
  wallet    String
  balance   BigInt   @default(0)
  updatedAt DateTime @updatedAt

  @@unique([mint, wallet])
  @@index([mint, balance])
}

model Follow {
  id          String   @id @default(cuid())
  follower    String
  following   String
  createdAt   DateTime @default(now())

  @@unique([follower, following])
  @@index([follower])
  @@index([following])
}

model CreatorProfile {
  wallet      String   @id
  displayName String?
  bio         String?
  avatarUrl   String?
  twitterUrl  String?
  websiteUrl  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       CreatorPost[]
}

model CreatorPost {
  id        String   @id @default(cuid())
  wallet    String
  content   String
  imageUrl  String?
  createdAt DateTime @default(now())
  creator   CreatorProfile @relation(fields: [wallet], references: [wallet], onDelete: Cascade)
}

model ReferralAccount {
  wallet          String   @id
  referralCode    String   @unique
  pendingBalance  Float    @default(0)
  totalEarned     Float    @default(0)
  totalReferrals  Int      @default(0)
  lastWithdrawnAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ReferralLink {
  id              String   @id @default(cuid())
  referredWallet  String   @unique
  referrerWallet  String
  cashbackBalance Float    @default(0)
  cashbackEarned  Float    @default(0)
  createdAt       DateTime @default(now())
}


model TelegramUser {
  id            Int      @id @default(autoincrement())
  telegramId    String   @unique
  username      String?
  firstName     String?
  encryptedKey  String
  walletAddress String
  slippageBps   Int      @default(300)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}


model BotAlert {
  id           Int      @id @default(autoincrement())
  telegramId   String
  chatId       String
  mint         String
  symbol       String   @default("TOKEN")
  alertType    String   // price_above | price_below | stop_loss | take_profit
  triggerPrice Float
  tokenAmount  String?
  triggered    Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())

  @@index([isActive])
  @@index([telegramId])
  @@index([mint, isActive])
}

